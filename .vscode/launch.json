      "console": "integratedTerminal",
      "presentation": {
        "group": "docs",
        "order": 1
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "🧪 Debug Tests (Vitest)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:debug"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "testing",
        "order": 1
      },
      "env": {
        "NODE_ENV": "test"
      }
    },
    {
      "name": "🔍 Debug Frontend Tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "testing",
        "order": 2
      },
      "env": {
