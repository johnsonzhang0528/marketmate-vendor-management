      }
    },
    {
      "name": "🎭 Debug Playwright Tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["playwright", "test", "--debug"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "e2e",
        "order": 1
      },
      "env": {
        "NODE_ENV": "test"
      }
    }
  ],
  "compounds": [
    {
      "name": "🚀 Full Stack Development",
      "configurations": [
        "🖥️ Debug Frontend (Vite)",
        "⚙️ Debug Backend (Node.js)"
      ],
      "presentation": {
        "group": "compound",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "📦 All Modules Development",
      "configurations": [
        "📦 Debug Inventory Module",
        "💰 Debug POS Module",
        "👥 Debug Customer Module",
        "📊 Debug Analytics Module"
      ],
      "presentation": {
        "group": "compound",
        "order": 2
      },
      "stopAll": true
    },
    {
      "name": "🧪 Complete Testing Suite",
      "configurations": [
        "🔍 Debug Frontend Tests",
        "🔍 Debug Backend Tests",
        "🎭 Debug Playwright Tests"
      ],
      "presentation": {
        "group": "compound",
        "order": 3
      },
