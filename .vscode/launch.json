{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🖥️ Debug Frontend (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "presentation": {
        "group": "frontend",
        "order": 1
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "⚙️ Debug Backend (Node.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/../worktrees/backend/src/index.ts",
      "cwd": "${workspaceFolder}/../worktrees/backend",
      "outFiles": ["${workspaceFolder}/../worktrees/backend/dist/**/*.js"],
      "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "marketmate:*"
      },
      "console": "integratedTerminal",
      "presentation": {
        "group": "backend",
        "order": 1
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "📦 Debug Inventory Module",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/inventory",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "modules",
        "order": 1
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "💰 Debug POS Module",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/pos",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "modules",
        "order": 2
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "👥 Debug Customer Module",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/customer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "modules",
        "order": 3
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "📊 Debug Analytics Module",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/analytics",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "modules",
        "order": 4
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "📱 Debug Mobile App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "mobile",
        "order": 1
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "📚 Debug Documentation",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/docs",
      "runtimeExecutable": "npm",
