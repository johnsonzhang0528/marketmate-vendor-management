      },
      "env": {
        "NODE_ENV": "test"
      }
    },
    {
      "name": "🗄️ Debug Database (Prisma Studio)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/../worktrees/backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["prisma", "studio"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "database",
        "order": 1
      },
      "env": {
        "NODE_ENV": "development"
