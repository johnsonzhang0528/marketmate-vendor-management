      "type": "shell",
      "command": "pwsh",
      "args": ["-File", "./scripts/init-worktrees.ps1"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "group": "setup"
      },
      "problemMatcher": [],
      "detail": "初始化所有 Git Worktree 和專案模組"
    },
    {
      "label": "🔄 Sync: Update All Worktrees",
      "type": "shell",
      "command": "pwsh",
